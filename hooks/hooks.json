{
  "description": "비개발자 친화 출력 규칙을 세션이 시작될 때 주입",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/rules/output-clarity.md\"; exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
